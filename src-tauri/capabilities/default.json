{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main onslicer window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "process:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*.onshape.com/*" }]
    },
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-remove"
  ]
}
