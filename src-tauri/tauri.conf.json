{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onslicer",
  "version": "0.1.0",
  "identifier": "com.pmaxhogan.onslicer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "onslicer",
        "width": 1240,
        "height": 840,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyMDI0RUQ1QzZCMjA1RUMKUldUc0JiTEcxVTRDNGgzaG1jL1A5NjJ0Q2wzaGpSTTh6ZDMzMkk2M0hYa1hCL3FSN1hZRGx6VmoK",
      "endpoints": [
        "https://github.com/pmaxhogan/onslicer/releases/latest/download/latest.json"
      ]
    }
  }
}
