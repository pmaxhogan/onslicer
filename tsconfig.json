{
  // Typechecks the TypeScript tooling (tests, vitest config). The app frontend in
  // src/ is plain JS served straight to the Tauri webview with no build step, so it
  // is not type-checked (checkJs off); allowJs lets the tests import it with
  // inferred types.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
